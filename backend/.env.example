# ==========================================================
#  .ENV.EXAMPLE - QRTIX BACKEND (FastAPI)
#  ==========================================================
#  Copia este archivo como .env en local y cambia los valores.
#  EN RAILWAY: NO subas .env. Configura estas variables
#  en Railway Dashboard → Variables.
#  ==========================================================

# ===== MongoDB Atlas (OBLIGATORIO) =====
# Copia tu connection string completo de MongoDB Atlas
MONGO_URI=mongodb+srv://<TU_USUARIO>:<TU_CONTRASENA>@<TU_CLUSTER>.mongodb.net/?retryWrites=true&w=majority&appName=<APP_NAME>

# ===== Base de datos y colecciones =====
DB_NAME=qrtixpro
COLLECTION_NAME=usuarios
SALES_COLLECTION=ventas
RESERVATIONS_COLLECTION=seat_reservations
LOGS_COLLECTION=logs

# ===== CORS (Seguridad - dominios permitidos) =====
# En desarrollo: http://localhost:3000
# En producción pon tus dominios del FRONTEND separados por coma.
# EJEMPLO para Vercel + local:
# CORS_ORIGINS=https://tudominio.com,https://tudominio.vercel.app,http://localhost:3000
#
# OPCIONAL: usa este regex permissivo temporalmente cuando pruebes:
# CORS_ORIGIN_REGEX=.*
CORS_ORIGIN=http://localhost:3000

# ===== Sistema de Reservas Temporales =====
# Minutos que los asientos permanecen bloqueados antes de comprar
RESERVATION_MINUTES=15

# ===== PUERTO (LOCAL SOLAMENTE - Railway usa $PORT automático) =====
PORT=8000

# ===== Umbral reconocimiento facial (DeepFace) =====
# 0.00 = muy estricto, 1.00 = muy laxo
# 0.50 = 50% de similitud mínima recomendado
FACE_RECOGNITION_THRESHOLD=0.50
